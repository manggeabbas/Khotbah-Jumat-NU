{
  "name": "khutbah-bot",
  "version": "0.1.0",
  "description": "Bot Khutbah Jumat Telegram — cari, baca, dan ekspor materi khutbah dari NU Online",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/",
    "lint": "node scripts/lint.js",
    "sync": "node src/scraper/cli-sync.js",
    "migrate": "node src/database/migrate.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "khutbah",
    "nu-online",
    "termux"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "arabic-reshaper": "^1.1.0",
    "bidi-js": "^1.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "telegraf": "^4.16.3"
  }
}
