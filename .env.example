# ============================================================
# Bot Khutbah Jumat — contoh konfigurasi
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Format: hanya NAMA variabel; nilai default ada di komentar.
# ============================================================

# --- Telegram ---
# Token dari @BotFather. RAHASIA — jangan dibagikan.
TELEGRAM_BOT_TOKEN=

# --- Owner / Admin ---
# ID Telegram owner/admin. NON-rahasia (bukan credential); hanya angka.
# Boleh dipisah koma bila lebih dari satu admin.
TELEGRAM_USER_ID=

# --- Supabase ---
SUPABASE_URL=
# Secret key (model API key terbaru, biasanya diawali "sb_secret_...").
# RAHASIA server; JANGAN dipakai di klien publik.
SUPABASE_SECRET_KEY=

# --- Migrasi database (opsional) ---
# Connection string PostgreSQL (untuk `npm run migrate -- --apply`).
# Sekali pakai; tidak dibutuhkan untuk menjalankan bot.
DATABASE_URL=

# --- Perilaku aplikasi (opsional) ---
# Maksimal hasil pencarian per halaman (default 8).
MAX_SEARCH_RESULTS=
# Maksimal riwayat per pengguna (default 50).
MAX_HISTORY=
# Interval sinkronisasi dalam jam (default 6).
SCRAPE_INTERVAL_HOURS=
# false = mode aman: metadata + cuplikan + tautan (default false).
# true  = simpan/tampilkan isi penuh + PDF turunan (butuh izin konten).
FULL_CONTENT_ENABLED=
# Panjang maksimal cuplikan mode aman (default 400).
SNIPPET_MAX_LENGTH=

# --- Scraper (opsional) ---
# User-Agent jelas; default "KhutbahJumatBot/0.1 (+https://github.com/; contact: developer@example.com)".
SCRAPER_USER_AGENT=
# Jeda antar permintaan ms (default 1500).
SCRAPER_REQUEST_DELAY_MS=
# Timeout permintaan ms (default 20000).
SCRAPER_TIMEOUT_MS=
# Maksimum retry per permintaan (default 3).
SCRAPER_MAX_RETRIES=
# Maksimum artikel per siklus, 0 = tanpa batas (default 50).
SCRAPER_MAX_ARTICLES=
# Halaman listing maksimum per sinkronisasi (default 3).
SCRAPER_MAX_LISTING_PAGES=

# --- Logging (opsional) ---
# debug | info | warn | error | silent (default info).
LOG_LEVEL=
