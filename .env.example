# ============================================================
# Bot Khutbah Jumat — contoh konfigurasi
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ============================================================

# --- Telegram ---
# Token dari @BotFather. Rahasia — jangan dibagikan.
BOT_TOKEN=

# --- Supabase ---
SUPABASE_URL=
# Gunakan service_role HANYA untuk proses server tepercaya (Termux).
# Atau anon key + RLS bila kebijakan RLS sudah disiapkan.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Admin ---
# Telegram ID admin (dipisah koma bila lebih dari satu).
ADMIN_TELEGRAM_ID=

# --- Perilaku aplikasi ---
# Maksimal hasil pencarian per halaman (PRD: 6-8).
MAX_SEARCH_RESULTS=8
# Maksimal riwayat per pengguna (PRD: 50).
MAX_HISTORY=50
# Interval sinkronisasi (jam), PRD default 6.
SCRAPE_INTERVAL_HOURS=6

# --- Kepatuhan hak konten ---
# false = mode aman: hanya metadata + cuplikan + tautan sumber.
# true  = simpan & tampilkan isi penuh + PDF turunan.
# Aktifkan true HANYA jika izin/lisensi penggunaan sudah dipastikan.
FULL_CONTENT_ENABLED=false
# Panjang maksimal cuplikan (karakter) pada mode aman.
SNIPPET_MAX_LENGTH=400

# --- Scraper ---
# User-Agent jelas dengan kontak.
SCRAPER_USER_AGENT=KhutbahJumatBot/0.1 (+https://github.com/; contact: developer@example.com)
# Jeda antar permintaan (ms) — sopan terhadap sumber.
SCRAPER_REQUEST_DELAY_MS=1500
# Timeout permintaan (ms).
SCRAPER_TIMEOUT_MS=20000
# Maksimum percobaan ulang per permintaan.
SCRAPER_MAX_RETRIES=3
# Maksimum artikel per satu siklus sinkronisasi (0 = tanpa batas).
SCRAPER_MAX_ARTICLES=50
# Halaman listing maksimum yang dipindai per sinkronisasi.
SCRAPER_MAX_LISTING_PAGES=3

# --- Logging ---
LOG_LEVEL=info
